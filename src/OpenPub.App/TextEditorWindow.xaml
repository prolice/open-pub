<Window x:Class="OpenPub.App.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le texte" Height="640" Width="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Chrome}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False" Icon="Assets/openpub.ico">
    <DockPanel Margin="12">
        <!-- Mise en forme -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="FontBox" Width="190" IsEditable="True" Margin="2,0" ToolTip="Police"
                          SelectionChanged="FontBox_SelectionChanged" KeyDown="FontBox_KeyDown"/>
                <ComboBox x:Name="SizeBox" Width="64" IsEditable="True" Margin="2,0" ToolTip="Taille (pt)"
                          SelectionChanged="SizeBox_SelectionChanged" KeyDown="SizeBox_KeyDown"/>
                <Separator Margin="6,2"/>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Gras (Ctrl+B)" FontWeight="Bold">G</Button>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Italique (Ctrl+I)" FontStyle="Italic">I</Button>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Souligné (Ctrl+U)">
                    <TextBlock Text="S" TextDecorations="Underline"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Color_Click" ToolTip="Couleur du texte">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="A" FontWeight="Bold"/>
                        <Border x:Name="ColorSwatch" Width="14" Height="4" Background="Black" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                    </StackPanel>
                </Button>
                <Separator Margin="6,2"/>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="Aligner à gauche">⯇≡</Button>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="Centrer">≡</Button>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="Aligner à droite">≡⯈</Button>
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}" ToolTip="Justifier">☰</Button>
            </WrapPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/>
            <Button Content="Annuler" Width="96" Padding="0,5" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Appliquer" Width="96" Padding="0,5" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>

        <RichTextBox x:Name="Editor" AcceptsTab="True" VerticalScrollBarVisibility="Auto" Padding="10"
                     SelectionChanged="Editor_SelectionChanged" TextChanged="Editor_TextChanged" SpellCheck.IsEnabled="True"
                     Language="fr-FR"/>
    </DockPanel>
</Window>
