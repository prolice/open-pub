<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenPub.Core\OpenPub.Core.csproj" />
    <ProjectReference Include="..\OpenPub.Layout\OpenPub.Layout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Export PDF direct (licence MIT) : version « Core », sans GDI ni WPF ; les polices viennent de Rendering/PdfFontResolver -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenPub</AssemblyName>
    <RootNamespace>OpenPub.App</RootNamespace>
    <ApplicationIcon>Assets\openpub.ico</ApplicationIcon>
    <Version>2.1.5</Version>
    <Product>OpenPub</Product>
    <Description>Éditeur de mise en page (remplacement de Microsoft Publisher)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\openpub.ico" />
    <Resource Include="Assets\openpub-*.png" />
    <!-- Polices de la charte (OFL) : DM Sans et Plus Jakarta Sans, graisses fixes -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Mises a jour automatiques : site Azure Static Web Apps (offre gratuite) et cle publique de signature.
       La cle privee correspondante est dans %APPDATA%\OpenPub\update-signing-key.pem (hors du depot). -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateFeed" Value="https://open-pub.prolice.net/latest.json" />
    <!-- Rapports d'erreur : relais du site (fonction Azure) qui detient le jeton GitHub et ouvre les issues -->
    <AssemblyMetadata Include="CrashReportUrl" Value="https://open-pub.prolice.net/api/crash" />
    <AssemblyMetadata Include="HelpBase" Value="https://open-pub.prolice.net/aide/" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="" />
  </ItemGroup>

</Project>
